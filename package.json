{
  "name": "freeconverterapp",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @freeconverterapp/web dev",
    "build": "pnpm --filter @freeconverterapp/web build",
    "test": "pnpm --filter @converter/web exec tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/converter.git"
  }
}
